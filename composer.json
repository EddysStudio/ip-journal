{
    "name": "eddysstudio/ip-journal",
    "description": "A plugin for logging and auditing visits and IP addresses for Laravel + Filament",
    "keywords": [
        "EddysStudio",
        "laravel",
        "filamentphp",
        "filament",
        "filament-plugin",
        "ip-journal"
    ],
    "homepage": "https://github.com/eddysstudio/ip-journal",
    "support": {
        "issues": "https://github.com/eddysstudio/ip-journal/issues",
        "source": "https://github.com/eddysstudio/ip-journal"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "EddysStudio",
            "email": "fred198094@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^4.0",
        "spatie/laravel-package-tools": "^1.15.0"
    },
    "require-dev": {
        "nunomaduro/collision": "^8.0",
        "orchestra/testbench": "^10.12",
        "pestphp/pest": "^3.8",
        "pestphp/pest-plugin-arch": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.2",
        "pestphp/pest-plugin-livewire": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "EddysStudio\\IpJournal\\": "src/",
            "EddysStudio\\IpJournal\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "EddysStudio\\IpJournal\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "lint": "pint",
        "test": "pest",
        "test:lint": "pint --test"
    },
    "extra": {
        "laravel": {
            "providers": [
                "EddysStudio\\IpJournal\\IpJournalServiceProvider"
            ],
            "aliases": {
                "IpJournal": "EddysStudio\\IpJournal\\Facades\\IpJournal"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
